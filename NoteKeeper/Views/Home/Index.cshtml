@{
    ViewData["Title"] = "Home";
}

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="eyebrow">A calmer place for your thoughts</span>
                <h1 class="hero-title">Welcome to<br /><span>NoteKeeper.</span></h1>
                <p class="hero-copy">
                    A simple and welcoming place to get started with keeping your ideas
                    and thoughts together.
                </p>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <p class="welcome-message">You are logged in to NoteKeeper.</p>
                }
                else
                {
                    <a class="btn btn-primary btn-lg"
                       asp-controller="Account" asp-action="Register">Get started</a>
                    <a class="btn btn-light btn-lg ms-2"
                       asp-controller="Account" asp-action="Login">Login</a>
                }
            </div>

            <div class="col-lg-6 text-center">
                <img src="~/assets/notekeeper-icon.png"
                     alt="NoteKeeper icon"
                     class="hero-icon" />
            </div>
        </div>
    </div>
</section>
