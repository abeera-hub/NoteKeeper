@model RegisterViewModel

@{
    ViewData["Title"] = "Sign up";
}

<main class="account-main">
    <div class="container">
        <div class="account-card">

            <div class="account-heading">
                <img src="~/assets/notekeeper-icon.png" alt="" class="account-icon" />

                <span class="eyebrow">A fresh page starts here</span>
                <h1>Create your account</h1>
                <p>Make a little space for all your ideas.</p>
            </div>

            <form asp-action="Register" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">Full name</label>
                    <input asp-for="FullName" class="form-control" placeholder="Your name" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email address</label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" class="form-control" placeholder="Create a password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Enter your password again" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button class="btn btn-primary w-100" type="submit">
                    Create account
                </button>

            </form>

            <p class="account-switch">
                Already have an account?
                <a asp-action="Login">Login</a>
            </p>

        </div>

        <p class="back-home">
            <a asp-controller="Home" asp-action="Index">Back to home</a>
        </p>

    </div>
</main>
